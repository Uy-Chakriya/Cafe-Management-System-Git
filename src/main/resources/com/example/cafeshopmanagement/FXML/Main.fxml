<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cafeshopmanagement.Controller.MainController">
    <AnchorPane fx:id="main_form" prefHeight="200.0" prefWidth="200.0">
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <left>
                <AnchorPane prefHeight="800.0" prefWidth="230.0" BorderPane.alignment="CENTER">
                    <AnchorPane prefHeight="800.0" prefWidth="230.0" styleClass="nav-form" stylesheets="@../Styles/Mainstyle.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                        <VBox alignment="CENTER" layoutX="0.0" layoutY="10.0" prefHeight="80.0" prefWidth="230.0" spacing="5.0">
                            <ImageView fx:id="cafe_logo_image" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="https://static.vecteezy.com/system/resources/previews/019/056/990/non_2x/isolated-brown-color-cup-in-retro-style-logo-logotype-for-coffee-shop-illustration-on-brown-background-vector.jpg" />
                                </image>
                            </ImageView>
                            <Label text="Cafe Street">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                        </VBox>

                        <VBox alignment="CENTER" layoutX="0.0" layoutY="100.0" prefHeight="90.0" prefWidth="230.0" spacing="5.0">
                            <ImageView fx:id="profile_image" fitHeight="65.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true" styleClass="profile-image" />
                            <Label fx:id="username" text="Admin">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label fx:id="profile_email" styleClass="profile-email" text="admin@gmail.com" />
                        </VBox>

                        <VBox layoutX="10.0" layoutY="220.0" prefHeight="250.0" prefWidth="210.0" spacing="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
                            <Button fx:id="dashboard_button" alignment="CENTER_LEFT" graphicTextGap="10.0" mnemonicParsing="false" onAction="#switchForm" prefHeight="40.0" prefWidth="210.0" styleClass="nav-btn" text=" Dashboard">
                                <graphic>
                                    <FontAwesomeIconView glyphName="DASHBOARD" size="1.2em" styleClass="icon-color" />
                                </graphic>
                            </Button>
                            <Button fx:id="inventory_button" alignment="CENTER_LEFT" graphicTextGap="10.0" mnemonicParsing="false" onAction="#switchForm" prefHeight="40.0" prefWidth="210.0" styleClass="nav-btn" text=" Inventory">
                                <graphic>
                                    <FontAwesomeIconView glyphName="CUBES" size="1.2em" styleClass="icon-color" />
                                </graphic>
                            </Button>
                            <Button fx:id="menu_button" alignment="CENTER_LEFT" graphicTextGap="10.0" mnemonicParsing="false" onAction="#switchForm" prefHeight="40.0" prefWidth="210.0" styleClass="nav-btn" text=" Menu">
                                <graphic>
                                    <FontAwesomeIconView glyphName="COFFEE" size="1.2em" styleClass="icon-color" />
                                </graphic>
                            </Button>
                            <Button fx:id="customers_button" alignment="CENTER_LEFT" graphicTextGap="10.0" mnemonicParsing="false" onAction="#switchForm" prefHeight="40.0" prefWidth="210.0" styleClass="nav-btn" text="Orders">
                                <graphic>
                                    <FontAwesomeIconView glyphName="USERS" size="1.2em" styleClass="icon-color" />
                                </graphic>
                            </Button>
                        </VBox>

                        <Button fx:id="log_out_button" layoutX="10.0" layoutY="750.0" mnemonicParsing="false" AnchorPane.bottomAnchor="11.0" AnchorPane.leftAnchor="10.0">
                            <graphic>
                                <FontAwesomeIconView glyphName="SIGN_OUT" size="1.5em" />
                            </graphic>
                            <styleClass>
                                <String fx:value="log-out" />
                                <String fx:value="shadow" />
                            </styleClass>
                        </Button>
                        <Label layoutX="45.0" layoutY="753.0" text="Log Out" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="45.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </AnchorPane>
                </AnchorPane>
            </left>
            <center>
                <StackPane fx:id="centralStackPane" BorderPane.alignment="CENTER" />
            </center>
        </BorderPane>
    </AnchorPane>
</StackPane>
